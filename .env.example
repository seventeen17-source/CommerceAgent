# CommerceAgent — 环境变量示例
#
# 用法（Docker Compose）：
#   cp .env.example .env       # 然后改成你自己的值
#   docker compose --env-file .env -f infra/docker-compose.yml up -d
#
# .env 已被仓库根 .gitignore 忽略，不会入库。本文件只放非密钥占位值。
#
# 重要：仓库根 `.env` 主要供 Docker Compose 使用。
# Spring Boot 不会自动读取这个文件；直接运行 Java 时，application.yml 通过进程环境变量/JVM
# System Property 读取同名配置。Python Agent 使用 `agent-service/.env`，且其路径已固定，不依赖
# 当前工作目录。变量名保持一致，是为了让不同启动方式容易对齐，但不要把三个加载机制混为一谈。

# ---------- 超级用户：仅用于数据库初始化，不得写入任何应用配置 ----------
POSTGRES_DB=commerceagent
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only

# ---------- 数据库连接位置 ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- commerce_app：Java 后端，拥有 commerce schema ----------
COMMERCE_APP_USER=commerce_app
COMMERCE_APP_PASSWORD=commerce_app_dev_only

# ---------- agent_app：Python Agent，拥有 agent / policy schema ----------
# 该角色对 commerce.* 无任何权限（由 infra/postgres/initdb 脚本强制）
AGENT_APP_USER=agent_app
AGENT_APP_PASSWORD=agent_app_dev_only

# ---------- migrator：Flyway 迁移专用角色 ----------
MIGRATOR_USER=migrator
MIGRATOR_PASSWORD=migrator_dev_only
